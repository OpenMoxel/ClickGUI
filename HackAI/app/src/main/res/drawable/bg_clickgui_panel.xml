<?xml version="1.0" encoding="utf-8"?>
<!--
  面板整体背景：
  - 填充色统一为 @color/hack_ai_panel（与顶/左/右/底各分区同色，符合"统一背景"要求）
  - 保留 12dp 圆角，clipToOutline 才能裁剪
  - 保留 1dp 描边作为面板边缘
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/hack_ai_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/hack_ai_stroke" />
</shape>
