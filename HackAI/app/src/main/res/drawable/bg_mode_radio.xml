<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="@color/hack_ai_selected" />
            <stroke android:width="1dp" android:color="@color/hack_ai_selected" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="@color/hack_ai_chip" />
            <stroke android:width="1dp" android:color="@color/hack_ai_chip_stroke" />
        </shape>
    </item>
</selector>
