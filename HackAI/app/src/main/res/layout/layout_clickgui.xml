<?xml version="1.0" encoding="utf-8"?>
<!--
  整体面板：统一背景色 @color/hack_ai_panel
  分区：顶部栏 / 左固定宽度边栏 / 右自适应内容
-->
<com.hack.ai.ui.ClickGuiPanel xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clickGuiPanel"
    android:layout_width="820dp"
    android:layout_height="500dp"
    android:background="@drawable/bg_clickgui_panel"
    android:clipToOutline="true"
    android:elevation="18dp"
    android:outlineProvider="background"
    android:orientation="vertical">

    <!-- ========== 1. 顶部标题栏（贯穿全宽） ========== -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/hack_ai_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <!-- 左：Home -->
        <TextView
            android:id="@+id/homeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="@color/hack_ai_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 中：搜索框（背景与面板区分，使用 hack_ai_search_bg） -->
        <EditText
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:hint="Search..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/hack_ai_text"
            android:textColorHint="@color/hack_ai_muted"
            android:textSize="13sp" />

        <!-- CN/EN 分段按钮 -->
        <LinearLayout
            android:id="@+id/langToggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_lang_toggle"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/langCN"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="CN"
                android:textColor="@color/hack_ai_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="@color/hack_ai_stroke_light" />

            <TextView
                android:id="@+id/langEN"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="EN"
                android:textColor="@color/hack_ai_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右：关闭面板 -->
        <TextView
            android:id="@+id/actionClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="⛶"
            android:textColor="@color/hack_ai_text"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 顶部与内容区的细分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.35"
        android:background="@color/hack_ai_separator" />

    <!-- ========== 2/3. 内容区域：左固定宽度导航 + 右自适应内容 ========== -->
    <LinearLayout
        android:id="@+id/clickGuiContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/hack_ai_panel"
        android:orientation="horizontal">

        <!-- 左侧导航边栏：固定宽度 200dp -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:background="@color/hack_ai_panel"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- 应用大标题 + 副标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HackAI"
                android:textColor="@color/hack_ai_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:text="Advanced Minecraft Utility"
                android:textColor="@color/hack_ai_muted"
                android:textSize="11sp" />

            <!-- 分类列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- 中间细分隔线 -->
        <View
            android:id="@+id/sidebarSeparator"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:background="@color/hack_ai_separator" />

        <!-- 右侧模块列表（自适应宽度） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/moduleRecycler"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/hack_ai_panel"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

</com.hack.ai.ui.ClickGuiPanel>
