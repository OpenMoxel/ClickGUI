<?xml version="1.0" encoding="utf-8"?>
<!--
  模块项：
  - 顶部行：左侧模块名/描述（weight=1），右侧 bind 徽标 + 开关（右对齐，开关始终在最右）
  - 扩展配置区域：默认隐藏，由代码根据开关状态展开，包含 value、slider、mode、shortcut、sub settings
  - 与主体之间有一条细分隔线作为视觉分割
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moduleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_module"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- 顶部行：模块信息（weight=1） + 开关（右对齐） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/moduleInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/moduleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hack_ai_text"
                android:textSize="14sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/moduleDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hack_ai_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 右侧动作区：bind + AnimatedSwitch（开关永远最右） -->
        <LinearLayout
            android:id="@+id/moduleActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/moduleBind"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_bind"
                android:gravity="center"
                android:minWidth="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/hack_ai_text"
                android:textSize="10sp" />

            <com.hack.ai.ui.AnimatedSwitch
                android:id="@+id/moduleSwitch"
                android:layout_width="38dp"
                android:layout_height="22dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 主体与扩展区的细分隔线（始终存在，扩展区隐藏时它会显示，但影响很小） -->
    <View
        android:id="@+id/expandDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:background="@color/hack_ai_separator"
        android:visibility="gone" />

    <!-- 扩展配置区域：每项默认隐藏，由代码按模块类型分别展开 -->
    <TextView
        android:id="@+id/moduleValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:minHeight="22dp"
        android:textColor="@color/hack_ai_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.hack.ai.ui.SettingSlider
        android:id="@+id/moduleSlider"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode"
            android:textColor="@color/hack_ai_muted"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeSecond"
                android:layout_width="72dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_mode_radio"
                android:button="@null"
                android:gravity="center"
                android:text="Second"
                android:textColor="@color/mode_radio_text"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/modeAverage"
                android:layout_width="80dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mode_radio"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="Average"
                android:textColor="@color/mode_radio_text"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/modeRandom"
                android:layout_width="80dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mode_radio"
                android:button="@null"
                android:gravity="center"
                android:text="Random"
                android:textColor="@color/mode_radio_text"
                android:textSize="11sp" />
        </RadioGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shortcutRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="显示快捷按钮"
            android:textColor="@color/hack_ai_muted"
            android:textSize="11sp" />

        <com.hack.ai.ui.AnimatedSwitch
            android:id="@+id/shortcutSwitch"
            android:layout_width="38dp"
            android:layout_height="22dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/subSettingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
